# Runtime
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database and authentication (required in production)
MONGODB_URI=
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Event configuration
EVENT_NAME=CODIENYCH 1.0
EVENT_TYPE=24-HOUR SOFTWARE HACKATHON
REGISTRATION_DEADLINE=2026-10-04
HACKATHON_START_DATE=2026-10-08T09:00:00
REGISTRATION_FEE=567
UPI_ID=
UPI_MERCHANT_NAME=CODIENYCH 1.0 Hackathon
COLLEGE_NAME=
VENUE=
ORGANIZER_EMAIL=
PHONE_NUMBER=

# Persistent upload storage (required for production uploads)
USE_CLOUDINARY=false
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional email delivery
ENABLE_EMAIL=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Initial admin seeding only; set securely before running the seed script
ADMIN_EMAIL=
ADMIN_PASSWORD=
